"Player controls never fade out." = "لا تختفي عناصر التحكم في المشغّل أبدًا.";
"Show Status Bar in Fullscreen" = "إظهار شريط الحالة في ملء الشاشة";
"Disable Previous/Next" = "إيقاف السابق/التالي";
"Grey out previous and next so they can't be tapped." = "يعطّل زرَّي السابق والتالي فلا يمكن النقر عليهما.";
"Used only with Gradient." = "يُستخدم مع التدرّج فقط.";
"Not used with the Default style." = "لا يُستخدم مع النمط الافتراضي.";
"Remove YouTube's quality limit on mobile data." = "يزيل حد الجودة الذي يفرضه YouTube على البيانات الخلوية.";
"Show the full resolution list instead of YouTube's simple menu." = "يعرض قائمة الدقة الكاملة بدلًا من قائمة YouTube المبسّطة.";
"Turns captions on in this language when a video has them." = "يشغّل الترجمة بهذه اللغة عندما تتوفر في الفيديو.";
"Hide the comments box under the video." = "يخفي مربع التعليقات أسفل الفيديو.";
"Hide shopping and product tags in videos, Shorts and feeds." = "يخفي علامات التسوق والمنتجات في الفيديوهات وShorts والخلاصات.";
"Normal Home Layout" = "تخطيط الصفحة الرئيسية العادي";
"Switches the tabbed Home redesign some accounts get back to the normal layout." = "يعيد تصميم الصفحة الرئيسية ذي التبويبات الذي تحصل عليه بعض الحسابات إلى التخطيط العادي.";
"Remove Filter Chips" = "إخفاء شرائح الفلاتر";
"Hide the filter chips at the top of Home and Subscriptions." = "يخفي شرائح الفلاتر أعلى الصفحة الرئيسية والاشتراكات.";
"Show a thin progress line at the bottom of Shorts." = "يعرض خط تقدم رفيعًا أسفل Shorts.";
"Play Shorts Once" = "تشغيل Shorts مرة واحدة";
"Pause at the end instead of replaying." = "يتوقف مؤقتًا في النهاية بدلًا من إعادة التشغيل.";
"Needs Download Button turned on in Downloads." = "يتطلب تفعيل زر التنزيل في التنزيلات.";
"Remove Pause Suggestions" = "إخفاء اقتراحات الإيقاف المؤقت";
"Hide the videos shown when you pause a Short." = "يخفي الفيديوهات التي تظهر عند إيقاف Short مؤقتًا.";
"Remove Suggestion Pill" = "إخفاء شريحة الاقتراح";
"Hide the suggestion pill above a Short's title." = "يخفي شريحة الاقتراح أعلى عنوان Short.";
"Remove Sound Button" = "إخفاء زر الصوت";
"Remove Notifications Button" = "إخفاء زر الإشعارات";
"Remove Messages Button" = "إخفاء زر الرسائل";
"Remove Search Button" = "إخفاء زر البحث";
"Ask before opening the Cast menu." = "يطلب التأكيد قبل فتح قائمة البث.";
"Needs the Liquid Glass tab bar." = "يتطلب شريط علامات تبويب Liquid Glass.";
"Pure black background in dark mode." = "خلفية سوداء بالكامل في الوضع الداكن.";
"Extra Dim" = "تعتيم إضافي";
"Keep a left-to-right layout in right-to-left languages." = "يحافظ على التخطيط من اليسار إلى اليمين في اللغات التي تُكتب من اليمين إلى اليسار.";
"Stop thumbnails and text from being dragged." = "يمنع سحب الصور المصغّرة والنصوص.";
"Use the iOS share sheet instead of YouTube's." = "يستخدم ورقة المشاركة في iOS بدلًا من ورقة YouTube.";
"Share at Current Time" = "المشاركة عند الوقت الحالي";
"Links shared from the iOS share sheet start where you are in the video." = "الروابط التي تُشارك من ورقة المشاركة في iOS تبدأ من موضعك في الفيديو.";
"Remove Search History" = "إخفاء سجل البحث";
"Hides past searches. Searches are still saved." = "يخفي عمليات البحث السابقة. لا تزال عمليات البحث محفوظة.";
"Also hides \"Are you still watching?\" and upgrade dialogs." = "يخفي أيضًا رسالة \"هل ما زلت تشاهد؟\" ونوافذ الترقية.";
"Skip the age check screen. Some videos may still be blocked." = "يتجاوز شاشة التحقق من العمر. قد تبقى بعض الفيديوهات محظورة.";
"Off turns off all downloads, including Shorts and playlists." = "عند الإيقاف تتوقف كل التنزيلات، بما فيها Shorts وقوائم التشغيل.";
"Clear cache when YouTube opens, at most once a day." = "يمسح ذاكرة التخزين المؤقت عند فتح YouTube، مرة واحدة يوميًا على الأكثر.";
"Delete temporary files and YouTube's cache." = "يحذف الملفات المؤقتة وذاكرة التخزين المؤقت لـ YouTube.";
"Double tapping the video does nothing." = "النقر المزدوج على الفيديو لا يفعل شيئًا.";
"Hold the left or right side to rewind or fast-forward." = "اضغط مطولًا على الجانب الأيسر أو الأيمن للترجيع أو التقديم السريع.";
"Seek Step" = "خطوة التقديم";
"Tap the progress bar to jump to that point." = "انقر على شريط التقدم للانتقال إلى تلك النقطة.";
"Two-Finger Tap to Pause" = "النقر بإصبعين للإيقاف المؤقت";
